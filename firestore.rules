rules_version = '2';

// ConnectMe security rules. Paste them in Firebase Console ->
// Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Community feed: any signed-in user can read; a user can only create
    // posts under their own uid; posts cannot be edited or deleted.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500;
      allow update, delete: if false;
    }

    // Member profiles (used by the profile screen in a later step): any
    // signed-in user can read; each user can only write their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
